{
  "name": "QuickWA — Direct & Bulk WhatsApp",
  "short_name": "QuickWA",
  "description": "Open a WhatsApp chat with any number without saving the contact. Direct chat, bulk queue, templates and history.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f5f4",
  "theme_color": "#0f9f6e",
  "categories": ["productivity", "social", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Contacts", "short_name": "Contacts", "url": "/?tab=contacts", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Paste & Chat", "short_name": "Paste", "url": "/?action=paste", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Bulk send", "short_name": "Bulk", "url": "/?tab=bulk", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "History", "short_name": "History", "url": "/?tab=history", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
