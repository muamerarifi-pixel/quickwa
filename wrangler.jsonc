// QuickWA: static files only, no server code and no secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickwa",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
