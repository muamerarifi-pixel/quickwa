// QuickWA: static PWA + a tiny sync API (/api/*). Static files never run the Worker.
// Sync data is stored end-to-end encrypted in the existing "doselog-data" KV namespace
// under keys prefixed "quickwa:" (no new Cloudflare resource).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickwa",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/share"]
  },
  "kv_namespaces": [
    { "binding": "KV", "id": "78f99b4a42fc4a968a7319f50d262a8f" }
  ]
}
